# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Hostinger: get this from hPanel → Databases → PostgreSQL
# Free alternative: Neon.tech (free PostgreSQL cloud DB)
DATABASE_URL=postgresql://user:password@localhost:5432/affiliatedeals

# ── Recommended for production ────────────────────────────────────────────────
# Your live domain (used for sitemap.xml)
SITE_URL=https://dux-ex.com

# Set to "production" for all deployments
NODE_ENV=production

# ── Optional ──────────────────────────────────────────────────────────────────
# Server port — Hostinger sets this automatically, do NOT set manually on Hostinger
# PORT=3000

# Comma-separated list of allowed CORS origins (defaults to all origins if unset)
# ALLOWED_ORIGINS=https://dux-ex.com,https://www.dux-ex.com

# Path to built frontend static files
# On Hostinger leave blank — auto-detected from server.js location
# STATIC_DIR=/home/username/affiliatedeals/public

# Session secret — change to a random 64-character string before going live!
SESSION_SECRET=change-me-to-a-random-64-char-string
