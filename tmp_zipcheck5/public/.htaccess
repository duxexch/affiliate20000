# ─── Apache SPA Routing ───────────────────────────────────────────────────────
# When serving the React frontend from Apache directly (not via Express),
# this rewrites all 404 paths back to index.html so React Router handles them.
#
# If you serve via Express (recommended for shared hosting), this file is unused.

Options -MultiViews
RewriteEngine On

# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Don't rewrite API routes (when proxying via ProxyPass to Express)
RewriteCond %{REQUEST_URI} !^/api/

# Rewrite everything else to index.html
RewriteRule ^ index.html [L]

# ─── Security & Performance ───────────────────────────────────────────────────
# Prevent directory listing
Options -Indexes

# MIME types
AddType application/javascript .js .mjs
AddType text/css .css

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
