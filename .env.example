# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/affiliatedeals

# ── Recommended for production ────────────────────────────────────────────────
# Your live domain (used for sitemap.xml and robots.txt)
SITE_URL=https://yourdomain.com

# Set to "production" for production deployments
NODE_ENV=production

# ── Optional ──────────────────────────────────────────────────────────────────
# Server port (defaults to 3000; cPanel Passenger sets this automatically)
PORT=3000

# Comma-separated list of allowed CORS origins (defaults to all origins if unset)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Path to built frontend static files (auto-detected if not set)
# STATIC_DIR=/home/username/affiliatedeals/artifacts/affiliate-site/dist/public

# Session secret for future JWT migration (currently using cookie-based sessions)
SESSION_SECRET=change-me-to-a-random-64-char-string
